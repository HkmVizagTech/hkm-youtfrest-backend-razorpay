# ── Server ─────────────────────────────────────────────────────────
PORT=3300
NODE_ENV=production

# ── CORS (comma-separated allowed frontend origins) ───────────────
ALLOWED_ORIGINS=https://youthfest.harekrishnavizag.org

# ── Database ───────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>/<db>?retryWrites=true&w=majority

# ── Auth ───────────────────────────────────────────────────────────
JWT_SECRET=<generate a long random string>

# ── Razorpay ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Flaxxa WAPI ───────────────────────────────────────────────────
# Brand API token — wapi.flaxxa.com › Brand › API Access
WAPI_TOKEN=
# Language code your templates were approved with (usually "en" or "en_US")
WAPI_TEMPLATE_LANG=en
# Approved template names for each of the 4 message types:
# Registration uses TWO templates — girls and boys WhatsApp group links are
# hardcoded into each at verification time (code picks by candidate.gender):
WAPI_TMPL_REGISTRATION_FEMALE=    # Template #1 — registration confirm (girls group link)
WAPI_TMPL_REGISTRATION_MALE=      # Template #1 — registration confirm (boys group link)
# WAPI_TMPL_REGISTRATION=         # optional fallback if the above aren't set
WAPI_TMPL_ATTENDANCE=     # Template #2 — attendance confirmed
WAPI_TMPL_CERTIFICATE=    # Template #3 — certificate delivery (PDF)
WAPI_TMPL_REMINDER=       # Template #4 — event-day reminder broadcast
# Template #5 — slot-change notice (Evening merged into Morning).
# 3 variables: {{1}} name, {{2}} new reporting time, {{3}} meal.
# Defaults to kp_slot_change in code, so this only needs setting if renamed.
WAPI_TMPL_SLOT_CHANGE=kp_slot_change
# Delay between sends in the slot-change broadcast (ms).
SLOT_CHANGE_THROTTLE_MS=1200

# ── Cloudinary (certificate PDF hosting) ─────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Auto certificate delivery (next day after slot) ────────────
# Automatically generates + sends the certificate (via Flaxxa WAPI)
# to PAID candidates whose attendance was marked. Certificates are
# sent the day AFTER the attendee's slot at CERTIFICATE_SEND_TIME
# (default 09:00) instead of immediately on slot completion.
# Non-attendees are never sent a certificate.
AUTO_SEND_CERTIFICATES=true
CERTIFICATE_JOB_INTERVAL_MINUTES=5
# The event's own date (IST calendar date). Certificates are sent to EVERYONE
# who is Paid + Attended at one moment: EVENT_DATE + CERTIFICATE_SEND_DELAY_DAYS
# at CERTIFICATE_SEND_TIME. It is NOT per-attendee — a late check-in or an
# attendance fix does not push that person's certificate to a later day.
# UPDATE THIS for the next event or nothing will be sent.
EVENT_DATE=2026-09-06
# IST wall-clock, always — the job converts internally, so this stays 09:00
# even though Railway's container runs in UTC. Do NOT "correct" it to 03:30.
CERTIFICATE_SEND_TIME=09:00
CERTIFICATE_SEND_DELAY_DAYS=1
# +05:30. Only change this if the event ever runs outside India.
CERTIFICATE_TZ_OFFSET_MINUTES=330
# Give up after this many failed delivery attempts (bad number, etc.) and
# leave the attendee for a manual resend instead of retrying every 5 min.
CERTIFICATE_MAX_ATTEMPTS=3

# ── Certificate name placement on the PDF template ───────────────
# Defaults match the KP26 Canva design (A4 landscape 842.25 × 595.5pt).
# Only set these if you re-cut the template and the name lands wrong.
# CERT_FONT_SIZE=30
# CERT_NAME_Y_RATIO=0.52
# CERT_NAME_CENTER_X=431.5
# CERT_NAME_MAX_WIDTH=600
# CERT_NAME_UPPERCASE=false
SLOT_MORNING_END=13:00
SLOT_EVENING_END=19:00

# ── Google Drive (certificate archival, optional) ─────────────────
GOOGLE_DRIVE_FOLDER_ID=

# ── Legacy Gupshup (kept for reference until fully replaced) ──────
# GUPSHUP_API_KEY=
# GUPSHUP_SOURCE=
# GUPSHUP_TEMPLATE_ID=

# ── WhatsApp provider routing ────────────────────────────────────
# Two registered senders, two WABAs, two independent Meta quality
# ratings and daily limits. A Meta rate limit belongs to the NUMBER,
# not the BSP — on 4 Sep 2026 the Flaxxa number hit a spam rate limit
# and dropped 165 accepted messages, so routing per message kind is
# how a bulk run is moved without a code change.
WHATSAPP_PROVIDER=flaxxa
# WHATSAPP_PROVIDER_SLOTCHANGE=gupshup
# WHATSAPP_PROVIDER_REMINDER=gupshup
# WHATSAPP_PROVIDER_CERTIFICATE=gupshup
# WHATSAPP_PROVIDER_ATTENDANCE=gupshup

# ── Gupshup (second sender: 917075176108) ────────────────────────
# Gupshup addresses templates by UUID; Flaxxa uses names. Nothing
# approved in one exists in the other.
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE=917075176108
# Approved on this account, verified 4 Sep 2026:
GUPSHUP_TMPL_SLOTCHANGE=d7c6e193-b649-483c-8e11-afc969d84eb0   # 3 vars: name, reporting time, meal
# GUPSHUP_TMPL_REMINDER_2HOUR=ce707c05-54ef-4e80-b0fd-c0f9885288f6  # 2 vars: name, reporting time
# GUPSHUP_TMPL_REMINDER_EVENTDAY=b4af5540-be96-4c65-98a5-8c09ee42529d # 3 vars
# GUPSHUP_TMPL_ATTENDANCE=88021e4e-88ae-4cba-bdba-f9b1be3b4948      # 1 var
# GUPSHUP_TMPL_CERTIFICATE=4b40f2ce-1efd-44c5-8a4a-e777ea8b84ee     # 1 var + PDF header

# Delivery callback (Flaxxa → Developer, and Gupshup callback URL).
# Without this, "accepted" never becomes "delivered" and we stay blind.
WAPI_WEBHOOK_KEY=
